---
import { t } from '../i18n';
import { Separator } from '@/components/starwind/separator';

const resourceLinks = [
  { href: '/blog/', label: 'Blog archive', ariaLabel: 'Blog' },
  { href: '/products/dayz-cheats/elite/', label: 'DayZ product details', ariaLabel: 'DayZ product details' },
  { href: '/products/dayz-cheats/', label: 'Plans and requirements', ariaLabel: 'Products' },
  { href: '/support/', label: t.footer.support },
];

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
  { href: '/terms/', label: t.footer.terms },
  { href: '/affiliate-disclosure/', label: 'Affiliate Disclosure' },
  { href: '/refund-policy/', label: 'Refund Policy' },
  { href: '/disclaimer/', label: 'Disclaimer' },
];

const shareUrl = encodeURIComponent(`https://getdayzcheats.net${Astro.url.pathname}`);
const shareLinks = [
  { href: `https://twitter.com/intent/tweet?url=${shareUrl}`, label: 'Share on X' },
  { href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`, label: 'Share on Facebook' },
  { href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`, label: 'Share on LinkedIn' },
];
---

<section id="site-banner" class="relative isolate min-h-48 overflow-hidden border-t border-primary/30 bg-[#07111f] sm:min-h-56" aria-label="DayZ Cheats website information">
  <picture class="absolute inset-0 -z-20 overflow-hidden">
    <source type="image/avif" srcset="/images/dayz-footer-banner-960.avif 960w, /images/dayz-footer-banner-1440.avif 1440w" sizes="100vw" />
    <source type="image/webp" srcset="/images/dayz-footer-banner-960.webp 960w, /images/dayz-footer-banner-1440.webp 1440w" sizes="100vw" />
    <img
      src="/images/dayz-footer-banner-1440.webp"
      alt="Blue tactical operators framing the DayZ Cheats footer banner"
      width="1440"
      height="480"
      loading="lazy"
      decoding="async"
      class="absolute left-1/2 top-1/2 h-[700px] w-auto max-w-none -translate-x-1/2 -translate-y-1/2 object-center"
    />
  </picture>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(4,10,20,.28),rgba(4,12,28,.08)_50%,rgba(4,10,20,.28)),linear-gradient(180deg,rgba(4,10,20,.08),rgba(4,10,20,.42))]"></div>
  <div class="mx-auto flex min-h-48 max-w-6xl flex-col items-center justify-center px-5 py-10 text-center sm:min-h-56">
    <a href="/" class="inline-flex items-center gap-3 rounded-xl border border-white/10 bg-black/20 px-4 py-2.5 backdrop-blur-sm" aria-label={t.ui.homeAria}>
      <img src="/dayz-logo-64.webp" alt="" width="38" height="38" class="rounded-lg" />
      <span class="font-[family-name:var(--font-heading)] text-2xl font-bold text-white"><span>DayZ</span><span class="text-primary">Cheats</span></span>
    </a>
    <p class="mt-5 text-xs font-bold uppercase tracking-[0.2em] text-slate-200 sm:text-sm">DayZ product information · Features · Setup guides</p>
    <p class="mt-2 text-sm text-slate-400">getdayzcheats.net</p>
  </div>
</section>

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5 font-[family-name:var(--font-heading)] text-lg font-bold" aria-label={t.ui.homeAria}>
          <img src="/dayz-logo-64.webp" alt="DayZ Cheats logo" width="32" height="32" class="rounded-md" />
          <span aria-hidden="true"><span class="brand-dayz">DayZ</span><span class="brand-cheats">Cheats</span></span>
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
        <nav aria-label="Share this page">
          <ul class="flex flex-wrap gap-x-3 gap-y-1">
            {shareLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs text-muted-foreground hover:text-primary"
                  target="_blank"
                  rel="nofollow noopener noreferrer"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground hover:text-primary"
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
