---
import {
  DEFAULT_IMAGE_WIDTHS,
  defaultWebpSrc,
  responsiveSrcSet,
} from '../utils/responsiveImage';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: readonly number[];
  class?: string;
  desktopOnly?: boolean;
  deferred?: boolean;
  avifSrc?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchPriority,
  sizes = '(min-width: 1024px) 640px, 100vw',
  widths = DEFAULT_IMAGE_WIDTHS,
  class: className,
  desktopOnly = false,
  deferred = false,
  avifSrc,
} = Astro.props;

const isRaster = /\.(png|jpe?g|webp)$/i.test(src);
const srcSet = responsiveSrcSet(src, widths);
const imgSrc = desktopOnly
  ? 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
  : defaultWebpSrc(src, widths);
const pictureSizes = desktopOnly ? '(min-width: 1024px) 490px, 1px' : sizes;
const pictureMedia = desktopOnly ? '(min-width: 1024px)' : undefined;
const transparentPixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const resolvedSrc = desktopOnly || deferred ? transparentPixel : defaultWebpSrc(src, widths);
const avifSrcSet = avifSrc ? `${avifSrc.replace('-640.avif', '-512.avif')} 512w, ${avifSrc} 640w` : undefined;
---

{
  isRaster ? (
    <picture>
      {avifSrc && (
        <source
          type="image/avif"
          srcset={deferred ? undefined : avifSrcSet}
          data-srcset={deferred ? avifSrcSet : undefined}
          sizes={pictureSizes}
          media={pictureMedia}
        />
      )}
      <source
        type="image/webp"
        srcset={deferred ? undefined : srcSet}
        data-srcset={deferred ? srcSet : undefined}
        sizes={pictureSizes}
        media={pictureMedia}
      />
      <img
        src={resolvedSrc}
        srcset={desktopOnly || deferred ? undefined : srcSet}
        data-src={deferred ? defaultWebpSrc(src, widths) : undefined}
        data-srcset={deferred ? srcSet : undefined}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={deferred ? 'low' : fetchPriority}
        sizes={pictureSizes}
        class={className}
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchPriority}
      class={className}
    />
  )
}
