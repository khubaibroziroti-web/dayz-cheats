---
import ResponsiveImage from './ResponsiveImage.astro';
import { HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from '../utils/responsiveImage';
import Icon from './icons/Icon.astro';

interface Slide {
  src: string;
  alt: string;
  caption: string;
  captionDesc: string;
  width?: number;
  height?: number;
  widths?: readonly number[];
}

interface Props {
  images: Slide[];
  id: string;
  variant?: 'default' | 'hero';
  desktopOnly?: boolean;
}

const { images, id, variant = 'default', desktopOnly = false } = Astro.props;
const isHero = variant === 'hero';
const imageSizes = isHero ? HERO_IMAGE_SIZES : '(min-width: 1024px) 640px, 100vw';
const imageWidths = isHero ? HERO_IMAGE_WIDTHS : undefined;
---

<div
  class:list={[
    'relative w-full',
    'rounded-xl border border-border bg-card p-2 shadow-sm',
    desktopOnly && 'hidden lg:block',
  ]}
  id={id}
  data-hero-embla-wrap={isHero || undefined}
>
  <div class="w-full overflow-hidden rounded-lg" data-hero-embla={isHero || undefined}>
    <div class="flex w-full snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-hero-viewport>
      <div class="flex w-full" data-hero-track>
      {images.map((img, i) => (
        <div class="w-full shrink-0 snap-start" data-hero-slide>
          <figure
            class:list={[
              isHero ? 'aspect-[16/10] overflow-hidden rounded-lg bg-muted/30' : 'overflow-hidden rounded-lg',
            ]}
          >
            <ResponsiveImage
              src={img.src}
              alt={img.alt}
              width={img.width ?? 960}
              height={img.height ?? 540}
              widths={img.widths ?? imageWidths}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchPriority={isHero && i === 0 ? 'high' : undefined}
              deferred={isHero && i > 0}
              sizes={imageSizes}
              desktopOnly={desktopOnly}
              class={isHero ? 'h-full w-full object-contain' : undefined}
            />
            {!isHero && (img.caption || img.captionDesc) && (
              <figcaption class="mt-2 px-1 text-sm text-muted-foreground">
                <strong class="text-foreground">{img.caption}</strong>
                {img.captionDesc && ` — ${img.captionDesc}`}
              </figcaption>
            )}
          </figure>
        </div>
      ))}
      </div>
    </div>
    {!isHero && images.length > 1 && (
      <>
        <button type="button" class="absolute left-2 top-1/2 z-10 -translate-y-1/2" data-hero-prev aria-label="Previous slide">
          <Icon name="chevronLeft" size={20} />
        </button>
        <button type="button" class="absolute right-2 top-1/2 z-10 -translate-y-1/2" data-hero-next aria-label="Next slide">
          <Icon name="chevronRight" size={20} />
        </button>
      </>
    )}
  </div>
  {isHero && images.length > 1 && (
    <div
      class="pointer-events-none absolute inset-x-2 bottom-1 flex justify-center sm:bottom-2"
      data-hero-embla-dots
      role="tablist"
      aria-label="Hero slides"
    >
      <div class="pointer-events-auto flex items-center rounded-full border border-white/10 bg-black/45 px-1 py-0.5 backdrop-blur-sm">
        {images.map((_, i) => (
          <button
            type="button"
            role="tab"
            class="hero-embla-dot relative flex size-8 shrink-0 items-center justify-center"
            data-hero-embla-dot={i}
            aria-label={`Slide ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <span class="hero-embla-dot-track pointer-events-none relative h-2 overflow-hidden rounded-full bg-white/30" aria-hidden="true">
              <span
                class="hero-embla-progress absolute inset-y-0 left-0 w-full origin-left scale-x-0 rounded-full bg-primary"
                data-hero-embla-progress
              />
            </span>
          </button>
        ))}
      </div>
    </div>
  )}
</div>

{isHero && (
  <script>
    import { setupHeroSlider } from '../scripts/hero-embla.ts';
    setupHeroSlider();
  </script>
)}
