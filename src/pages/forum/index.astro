---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/icons/Icon.astro';
import { resolvePageSeo } from '../../config/seo';

const seo = resolvePageSeo('/forum/');
const resources = [
  { icon: 'navProducts', title: 'Product details', desc: 'Review the complete feature list, requirements and access durations.', href: '/products/dayz-cheats/elite/', label: 'View product' },
  { icon: 'navBlog', title: 'Feature guides', desc: 'Read plain-language guides to ESP groups, requirements and pricing.', href: '/blog/', label: 'Read guides' },
  { icon: 'navFaq', title: 'Questions and answers', desc: 'Find answers about compatibility, plans, affiliate checkout and risk.', href: '/faq/', label: 'Open FAQ' },
  { icon: 'navSupport', title: 'Support resources', desc: 'Find pre-purchase help and external merchant guidance.', href: '/support/', label: 'Get support' },
];
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="border-b border-border bg-background pb-16 pt-28 sm:pt-32">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Community', path: '/forum/' }]} />
      <div class="mx-auto mt-10 max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">Community resources</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">DayZ product community hub</h1>
        <p class="mt-5 text-base leading-7 text-muted-foreground">Browse verified product information, buying guides, frequently asked questions and support resources without invented community posts or statistics.</p>
      </div>
    </div>
  </section>

  <section class="bg-background py-16 sm:py-20" aria-labelledby="community-resources">
    <div class="mx-auto max-w-6xl px-5">
      <h2 id="community-resources" class="sr-only">Community resources</h2>
      <div class="grid gap-5 md:grid-cols-2">
        {resources.map((resource) => (
          <article class="flex h-full flex-col rounded-2xl border border-border bg-card p-6 shadow-sm">
            <span class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary"><Icon name={resource.icon} size={22} /></span>
            <h3 class="mt-5 text-xl font-bold text-foreground">{resource.title}</h3>
            <p class="mt-2 flex-1 leading-7 text-muted-foreground">{resource.desc}</p>
            <a class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-xl border border-border px-4 py-2 font-semibold text-foreground transition hover:border-primary hover:text-primary" href={resource.href}>
              {resource.label}<Icon name="arrowRight" size={17} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
