---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { faqPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';

const seo = resolvePageSeo('/');
const homeFaqs = getLandingFaqs();
const heroLcpImage = webpSrc('/images/dayz-screenshots/dayz-player-esp.webp', 640);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[websiteSchema(), organizationSchema(), faqPageSchema(homeFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection />
  <div class="deferred-section" data-deferred-section style="--deferred-size: 1500px">
    <FeaturesSection />
  </div>
  <div class="deferred-section" data-deferred-section style="--deferred-size: 850px">
    <ProductsSection />
  </div>
  <div class="deferred-section" data-deferred-section style="--deferred-size: 1800px">
    <WhySetupSection />
  </div>
  <div class="deferred-section" data-deferred-section style="--deferred-size: 2500px">
    <ContentSections />
  </div>
</BaseLayout>
